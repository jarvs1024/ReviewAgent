# ReviewAgent 实例配置模板
#
# 用法：
#   cp config/examples/instance.env.example config/instance.env
#   chmod 600 config/instance.env
#   填入真实密钥后：.venv/bin/python -m reviewagent config check
#
# 规则：
#   · 只写需要改的键；注释掉的键表示"用 schema 默认值"，需要时取消注释。
#   · 注释必须单独成行（systemd 不会剥离行尾 #）。
#   · 含空格的值加双引号，例如 "Mon 09:00"。
#   · 密钥只放本文件；本文件在 .gitignore 中。

# ---- GitLab（前三项必填）----
# GitLab 地址，不要带结尾斜杠
GITLAB_URL=
# bot 账号 PAT，至少 api scope
GITLAB_PERSONAL_ACCESS_TOKEN=
# webhook X-Gitlab-Token 比对值
GITLAB_WEBHOOK_SECRET=
# 机器人用户名，逗号分隔别名（默认 review-agent）
GITLAB_BOT_USERNAME=review-agent
# 关闭防回环检查（默认 false；仅排障时临时打开）
# GITLAB_DISABLE_BOT_LOOP_CHECK=false

# ---- LLM 后端 ----
# qoder-sdk（推荐）| qodercli（子进程兜底）| opencode（HTTP 兜底）
LLM_PROVIDER=qoder-sdk
# qoder-agent-sdk 的 PAT；intl 与 cn 不通用
QODER_SDK_PAT=
# 站点（默认 intl）：intl 或 cn（PAT 与站点必须匹配）
# QODER_SDK_EDITION=intl
# CLI 可执行文件；空则按站点在 PATH 查（cn=qoderclicn / intl=qodercli）
# QODER_SDK_CLI_PATH=/path/to/qoderclicn
# 模型优先级：QODER_SDK_MODEL > QODERCLI_MODEL > 内置 Lite
# 名字按站点取值（cn 用 qoderclicn --list-models 查，如 Auto / Qwen3.8-Max）；
# 用错站点模型名会报 error_during_execution
QODER_SDK_MODEL=
# QODERCLI_MODEL=Qwen3.8-Max
# 单次 SDK 等待上限（秒，默认 600）；须 < RQ_WORKER_TIMEOUT
# QODER_SDK_TIMEOUT=900
# 工具轮数上限（0=不限，默认 0）
# QODER_SDK_MAX_TURNS=0
# 禁用工具（默认 write,edit,bash,webfetch,websearch）
# QODER_SDK_DISALLOWED_TOOLS=write,edit,bash,webfetch,websearch

# qodercli 兜底参数（仅 LLM_PROVIDER=qodercli 时生效）
# QODERCLI_TIMEOUT=600
# QODERCLI_MAX_TURNS=20

# opencode 兜底参数（仅 LLM_PROVIDER=opencode 时生效）
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_USERNAME=opencode
# OPENCODE_PASSWORD=
# OPENCODE_MODEL=deepseek/deepseek-v4-flash
# OPENCODE_TIMEOUT=900

# ---- Redis / RQ ----
# 本地专用实例；避免与其它系统共用库
REDIS_URL=redis://127.0.0.1:6380/0
# 主队列名（默认 review）；周报队列默认派生为 <主队列>-weekly
# RQ_QUEUE_NAME=review
# 周报队列名（默认 review-weekly）
# RQ_WEEKLY_QUEUE_NAME=review-weekly
# worker 并发数（默认 3）
RQ_WORKER_COUNT=3
# 单个 job 超时（秒，默认 1200）；须 >= LLM 超时 + 收尾余量
RQ_WORKER_TIMEOUT=1200

# ---- 场景包 ----
# 场景目录名，对应 profiles/<name>/；留空时自动选中唯一场景包（多个场景则启动失败）
REVIEW_PROFILE=ssd-python-autotest
# 场景包根目录（默认仓库 profiles/）；只有场景包放在别处时才需要
# REVIEW_PROFILE_ROOT=/path/to/profiles
# 用户调参目录（默认与 profiles/ 同级）；一般不用改
# REVIEW_CONFIG_DIR=/path/to/config

# ---- 数据目录 ----
# telemetry.db / repos/ / weekly_reports/ 的根（默认 ./data）
# 切换场景包时必须换一个新目录（data/instance.json 会绑定场景）
# REVIEWAGENT_DATA_DIR=./data

# ---- 日志 ----
# 级别（默认 INFO）
REVIEWAGENT_LOG_LEVEL=INFO
# text | json（默认 text）
LOG_FORMAT=text
# single | none（默认 single）
# LOG_ROTATION=single

# ---- 命令与冷却 ----
# 允许在 MR 上触发的命令（默认 describe,improve）
# PR_COMMANDS=describe,improve
# push 事件触发的命令（默认 describe,improve）
# PUSH_COMMANDS=describe,improve
# 同一 MR 的触发冷却（秒，默认 60）
# MR_COOLDOWN_SECONDS=60
# 单 MR 最大检视次数（默认 30）
# MAX_REVIEW_CALLS_PER_MR=30

# ---- 周报 ----
# 总开关（默认 true）
# REVIEWAGENT_WEEKLY_ENABLED=true
# 统计的目标项目 ID（默认 0 = 不采集 merged MRs）
# 目标项目 id（示例 = 真实业务仓库 ssd-real-biz-full；不要照抄 E2E 临时项目 id）
REVIEWAGENT_WEEKLY_TARGET_PROJECT_ID=31
# 目标分支（默认 main）
# REVIEWAGENT_WEEKLY_TARGET_BRANCH=main
# 时区（默认 Asia/Shanghai）
# REVIEWAGENT_WEEKLY_TIMEZONE=Asia/Shanghai
# 采集器（默认 telemetry,merged_mrs,repo_scan）
# REVIEWAGENT_WEEKLY_COLLECTORS=telemetry,merged_mrs,repo_scan
# 通知渠道（默认 dingtalk）
# REVIEWAGENT_WEEKLY_NOTIFIER=dingtalk
# 定时表达式（默认 "Mon 10:30"）
# REVIEWAGENT_WEEKLY_CRON_SCHEDULE="Mon 09:00"
# 标题留空 = 用场景包 reporting.weekly_title
# REVIEWAGENT_WEEKLY_REPORT_TITLE=
# REVIEWAGENT_WEEKLY_REPORT_EMOJI=📊
# 钉钉机器人 webhook（含 access_token，按凭证管理）
REVIEWAGENT_WEEKLY_DINGTALK_WEBHOOK_URL=
# 加签密钥（空 = 机器人未开启加签）
REVIEWAGENT_WEEKLY_DINGTALK_SECRET=
# true = 只渲染不发送（默认 true）
# REVIEWAGENT_WEEKLY_DINGTALK_DRY_RUN=false
# 重试次数（默认 3）
# REVIEWAGENT_WEEKLY_DINGTALK_RETRY=3
# Markdown 分片上限（默认 18000）
# REVIEWAGENT_WEEKLY_MD_CHUNK_LIMIT=18000
# 看板地址（默认 http://127.0.0.1:8080/code-review）
# REVIEWAGENT_WEEKLY_DASHBOARD_URL=http://127.0.0.1:8080/code-review
