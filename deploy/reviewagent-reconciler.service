[Unit]
Description=ReviewAgent Reconciler (sync ✓ resolved state and sweep orphan runs)
After=network-online.target redis-server.service redis.service
Wants=network-online.target

[Service]
Type=oneshot
User=workflow
WorkingDirectory=/home/workflow/ReviewAgent
Environment="PATH=/home/workflow/ReviewAgent/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment=REVIEWAGENT_DATA_DIR=/var/lib/reviewagent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/workflow/ReviewAgent/config/instance.env
ExecStartPre=/home/workflow/ReviewAgent/.venv/bin/python -m reviewagent config check
ExecStart=/home/workflow/ReviewAgent/.venv/bin/python -m reviewagent.reconciler.loop
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
