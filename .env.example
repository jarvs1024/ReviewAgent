# ==========================================================================
# ReviewAgent 环境变量模板 —— 只保留「实例平面」键（约 15 项）
#
# 用法: cp .env.example .env，再填入真实值（.env 已在 .gitignore 中）
# 只有 GITLAB_* 三项必填；其余留空即用 reviewagent/settings/schema.py 的默认值。
#
# 注意: 本文件会被 systemd EnvironmentFile 直接解析，**值里不要写行内注释**，
#       注释一律单独成行（systemd 不会剥离行尾 #）。
#
# 不在本文件的字段都属于「场景平面」（限制 / improve 权重 / 规则 / 周报采集等），
# 由 profile 包提供且有 schema 默认值，完整清单与来源见 docs/CONFIG.md。
# ==========================================================================

# ---- GitLab（必填）----
# GitLab 地址，如 https://gitlab.example.com
GITLAB_URL=
# bot 账号 PAT，最低 api scope
GITLAB_PERSONAL_ACCESS_TOKEN=
# webhook X-Gitlab-Token 比对值
GITLAB_WEBHOOK_SECRET=
# 机器人用户名；支持逗号分隔别名，匹配 名字@用户名 两侧
GITLAB_BOT_USERNAME=review-agent

# ---- LLM Provider ----
# qoder-sdk（推荐，需 PAT）| qodercli（旧 subprocess 兜底）| opencode（HTTP API 兜底）
LLM_PROVIDER=qoder-sdk
# Personal Access Token；intl/cn 各自的 token 不通用
QODER_SDK_PAT=
# 空 = 回落 QODERCLI_MODEL；调试可用 Lite
QODER_SDK_MODEL=

# ---- Redis / RQ ----
REDIS_URL=redis://127.0.0.1:6379/0
# 并发 worker 数
RQ_WORKER_COUNT=3
# RQ job_timeout（秒），须 >= max(LLM 超时) + buffer，否则 SIGKILL 会留下 stuck-run
RQ_WORKER_TIMEOUT=1200

# ---- 实例平面 ----
# 场景包名；启动时绑定到 data_dir 下的 instance.json，切换场景必须换 data_dir
REVIEW_PROFILE=ssd-python-autotest
# 持久化根目录（telemetry.db / repos/ / weekly_reports/）
REVIEWAGENT_DATA_DIR=/var/lib/reviewagent
REVIEWAGENT_LOG_LEVEL=INFO
# text（现网观感）| json（机读单行）
LOG_FORMAT=text

# ---- 周报投递（钉钉）----
# webhook URL 内含 access_token，按凭证管理；短名 DINGTALK_WEBHOOK 仍可作为兼容别名
REVIEWAGENT_WEEKLY_DINGTALK_WEBHOOK_URL=
# 钉钉机器人加签密钥；空 = 不加签
REVIEWAGENT_WEEKLY_DINGTALK_SECRET=

# 说明:
#   · RQ_WORKER_CLASS 是 RQ CLI 的运维参数，不在 SCHEMA，按平台写进 systemd unit
#     （见 docs/DEPLOYMENT.md）。
#   · 所有值的类型 / 取值范围由 schema 校验，非法值在 `reviewagent config check` 即失败。
