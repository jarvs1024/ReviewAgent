# ==========================================================================
# ReviewAgent 环境变量模板
#
# 用法: cp .env.example .env，再填入真实值（.env 已在 .gitignore 中）
# 所有变量都有默认值，只有 GITLAB_* 三个是必填（required=True）
# ==========================================================================

# ---- GitLab（必填）----
GITLAB_URL=https://gitlab.internal.company.com
GITLAB_PERSONAL_ACCESS_TOKEN=           # bot 账号 PAT，最低 api scope
GITLAB_WEBHOOK_SECRET=                  # webhook X-Gitlab-Token 比对值
GITLAB_BOT_USERNAME=review-agent           # 支持逗号分隔别名，匹配 名字@用户名 两侧
GITLAB_DISABLE_BOT_LOOP_CHECK=false                  # true → 跳过 is_bot() 判断, 测试环境兜底用

# ---- opencode（LLM 推理服务）----
OPENCODE_URL=http://localhost:4096      # opencode serve 地址（86 服务器或本地）
OPENCODE_USERNAME=opencode              # Basic Auth 用户名
OPENCODE_PASSWORD=                      # Basic Auth 密码（本地可空）
OPENCODE_MODEL=deepseek/deepseek-v4-flash  # opencode 使用的 LLM 模型 (provider/modelID)
OPENCODE_TIMEOUT=900                    # opencode HTTP 请求默认超时（秒）



# ---- LLM Provider 适配层 ----
# opencode 和 qodercli 二选一; 详见 docs/LLM_PROVIDER_ADAPTER.md
LLM_PROVIDER=qodercli               # opencode | qodercli
# ---- Redis / RQ（任务队列）----
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=review                    # 主 review 命令队列名
RQ_WEEKLY_QUEUE_NAME=review-weekly      # 周报独立队列 (默认 {RQ_QUEUE_NAME}-weekly)
RQ_WORKER_TIMEOUT=1200                   # RQ job_timeout (秒), 必须 >= max(QODERCLI_TIMEOUT, OPENCODE_TIMEOUT) + buffer, 否则 SIGKILL horse 引发 stuck-run
RQ_WORKER_COUNT=3                       # 并发 worker 数
RQ_WORKER_CLASS=reviewagent.workers.rq_worker.ReviewAgentSpawnWorker  # macOS 本地避免 RQ fork crash

# ---- 命令链（每个 MR 按顺序串行执行）----
PR_COMMANDS=describe,improve            # MR 事件触发的命令链
PUSH_COMMANDS=describe,improve          # Push 事件触发的命令链

# ---- 存储 ----
REVIEWAGENT_DATA_DIR=./data             # 持久化根目录（telemetry.db、weekly_reports/ 等）
REVIEWAGENT_LOG_LEVEL=INFO

# ---- 检视限制 ----
MR_COOLDOWN_SECONDS=30                  # per-MR 检视间隔（秒）
MAX_REVIEW_CALLS_PER_MR=30              # 0 = 不限；>0 强制上限
MAX_DIFF_CHARS=50000                    # diff 超过此字符数则跳过检视
OPENCODE_MAX_DIFF_CHARS=20000           # opencode prompt 内联 diff 截断阈值

# ---- AGENTS.md 仓库规则 ----
REPO_CONTEXT_FILES=AGENTS.md            # 从仓库默认分支读取的规则文件 (逗号分隔)
REPO_CONTEXT_RULES_DIR=.agents/rules    # 规则目录 (自动读取其下所有 .md)
RULE_KEY_PREFIX=SSD                     # 规则键前缀 (如 SSD-RULE-NO-LOG-EXC)
REPO_CONTEXT_MAX_LINES=2000             # 规则文件最大行数 (超出截断)

# ---- improve 并行 + 限流 ----
IMPROVE_PARALLEL_WORKERS=3              # 按文件分块并行调 opencode 的路数
IMPROVE_MAX_FILES=20                    # 单次检视最大文件数 (0=不限)
IMPROVE_MAX_SUGGESTIONS=15              # 单次最大 inline 建议数 (0=不限)
IMPROVE_MIN_SCORE=0                     # 改进建议最低分数 (0=不过滤, 建议值 20~40)

# ---- 检视文件过滤 ----
REVIEW_EXCLUDE_EXTENSIONS=.md,.doc,.docx,.txt,.rst,.csv,.png,.jpg,.jpeg,.gif,.svg,.ico

# ---- 周报 (weekly report) ----
REVIEWAGENT_WEEKLY_ENABLED=true                           # false 则跳过周报生成
REVIEWAGENT_WEEKLY_TARGET_PROJECT_ID=0                    # 目标 GitLab 项目 id (0 = merged_mrs/repo_scan 段 skipped)
REVIEWAGENT_WEEKLY_TARGET_BRANCH=main                     # 周报统计的目标分支
REVIEWAGENT_WEEKLY_TIMEZONE=Asia/Shanghai                 # 周报时区
REVIEWAGENT_WEEKLY_COLLECTORS=telemetry,merged_mrs,repo_scan  # 启用的 collector 段 (逗号或空格分隔)
REVIEWAGENT_WEEKLY_NOTIFIER=dingtalk                      # 通知器类型
REVIEWAGENT_WEEKLY_CRON_SCHEDULE="Mon 09:00"              # systemd timer 触发时间 (OnCalendar 格式)
REVIEWAGENT_WEEKLY_REPORT_TITLE=SSD自动化代码检视周报     # 周报标题
REVIEWAGENT_WEEKLY_REPORT_EMOJI=📊                        # 周报 emoji
REVIEWAGENT_WEEKLY_DASHBOARD_URL=http://127.0.0.1:8080/code-review  # 检视看板地址, 渲染到「本周检视概况」末尾 (空=不显示)

# ---- 钉钉推送 ----
# webhook 优先用命名空间前缀版本; DINGTALK_WEBHOOK 为短名兼容回退 (两者 or 关系)
REVIEWAGENT_WEEKLY_DINGTALK_WEBHOOK_URL=                  # 钉钉机器人 webhook URL (空 = dry_run)
DINGTALK_WEBHOOK=                                        # 兼容短名 (与上行二选一, 优先用上行)
REVIEWAGENT_WEEKLY_DINGTALK_SECRET=                      # 钉钉机器人加签密钥
REVIEWAGENT_WEEKLY_DINGTALK_DRY_RUN=true                 # true 只 log 不实际推送
REVIEWAGENT_WEEKLY_DINGTALK_RETRY=3                      # 钉钉推送重试次数
REVIEWAGENT_WEEKLY_MD_CHUNK_LIMIT=18000                  # Markdown 分块大小上限 (钉钉单条消息限制)

# ---- QoderCLI subprocess driver ----
# Node + qodercli.js + 模型/超时 (subprocess 模式, 当前唯一驱动)
QODERCLI_NODE_PATH=                     # node 可执行文件; 空则 `shutil.which('node')` (推荐留空)
QODERCLI_JS_PATH=                       # qodercli.js 路径; 空则 `os.path.realpath(shutil.which('qodercli'))` (推荐留空, 自动跟随 npm 安装位置)
QODERCLI_MODEL=DeepSeek-V4-Flash        # 与 opencode 模型对齐
QODERCLI_TIMEOUT=600                    # subprocess 单任务超时（秒）
QODERCLI_PERMISSION_MODE=               # Headless --permission-mode (accept_edits / bypass_permissions / dont_ask / auto). 空 = 不传.
QODERCLI_MAX_TURNS=20                   # Headless --max-turns 上限 (兜底, 防 qodercli 无限循环)
